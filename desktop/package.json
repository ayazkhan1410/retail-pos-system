{
  "name": "tijori-desktop",
  "version": "0.1.0",
  "description": "Tijori POS desktop app",
  "main": "main.js",
  "private": true,
  "author": "Tijori",
  "scripts": {
    "postinstall": "node scripts/install-electron.js",
    "install:electron": "node scripts/install-electron.js",
    "start": "node scripts/start-electron.js",
    "dev": "node scripts/start-electron.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:dir": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "pk.tijori.pos",
    "productName": "Tijori POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Tijori-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
